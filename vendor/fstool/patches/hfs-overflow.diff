+/// BeeZip: the catalog file's CNID (`kHFSCatalogFileID`).
+pub const CATALOG_FILE_ID: u32 = 4;
+/// BeeZip: the attributes file's CNID (`kHFSAttributesFileID`).
+pub const ATTRIBUTES_FILE_ID: u32 = 8;
+
+/// BeeZip: a special file's fork (the catalog's, the attributes'), with the extents past its
+/// eighth from the extents-overflow file, keyed by the special file's CNID, as TN1150 lets a
+/// volume keep them. A fork that fits inline reads as before.
+pub fn special_fork(
+    dev: &mut dyn BlockDevice,
+    vh: &VolumeHeader,
+    fork: &ForkData,
+    file_id: u32,
+    what: &str,
+) -> Result<ForkReader> {
+    if u64::from(fork.total_blocks) <= fork.inline_blocks() || vh.extents_file.total_blocks == 0 {
+        return ForkReader::from_inline(fork, vh.block_size, what);
+    }
+    let ext_fork = ForkReader::from_inline(&vh.extents_file, vh.block_size, "extents-overflow")?;
+    let overflow = ExtentsOverflow::open(dev, ext_fork)?;
+    let first = u32::try_from(fork.inline_blocks()).map_err(|_| {
+        crate::Error::InvalidImage(format!("hfs+: the {what} fork's block count overflows"))
+    })?;
+    let extra = overflow.find_extents(dev, file_id, extents::FORK_DATA, first)?;
+    ForkReader::from_inline_plus_overflow(fork, &extra, vh.block_size, what)
+}
