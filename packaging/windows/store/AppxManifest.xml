<?xml version="1.0" encoding="utf-8"?>
<!--
  BeeZip's Microsoft Store package (docs/M12.md §2.1): the installer's programs, packed whole.
  Microsoft signs it after certification, so it is never signed here.

  `cargo xtask dist` fills in the placeholders (store.rs): the identity Partner Center assigned
  to the product (`beezip_commands::shell::store`), the version in four parts with the last 0,
  the menu DLL's file name, the Store root's class, and one file type association per extension
  the installer associates, from formats.list.
  - Virtualization is left on (decision 1): Microsoft keeps the capability that turns it off for
    games. %TEMP% isn't virtualized, and folders that already exist in AppData are written in
    place.
  - No command line: one application, the app. The CLI's console alias needs an application of
    its own, hidden from Start, and Partner Center refuses a hidden application without
    Microsoft's HeadlessAppBypass waiver (docs/M12.md §14).
  - The menu is the same DLL the installer has, under its own class, the Store root: one verb
    for files and one for folders, as in the sparse package.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  IgnorableNamespaces="uap rescap com desktop4 desktop5">
  <Identity Name="{{NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>BeeZip</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="BeeZip" Executable="BeeZip.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="BeeZip" Description="Open, extract and create archives"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
{{ASSOCIATIONS}}
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="BeeZip's Explorer menu">
              <com:Class Id="{{CLSID}}" Path="{{DLL}}" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="BeeZip" Clsid="{{CLSID}}" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="BeeZip" Clsid="{{CLSID}}" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
