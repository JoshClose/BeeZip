{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "core:window:allow-destroy",
    "core:app:allow-set-app-theme",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$CONFIG/BeeZip/config.toml" }]
    },
    "allow-cmd-run",
    "allow-cmd-cancel",
    "allow-cmd-respond",
    "allow-cmd-list"
  ]
}
